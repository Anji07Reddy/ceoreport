// Prisma schema — Anuhar Homes CRM Performance Dashboard.
//
// SQLite for zero-config local dev. Switch `provider` to "postgresql" and set
// DATABASE_URL to a Postgres URL to use Postgres instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One ingest = one upload of the daily CRM Daily Leads + Followup exports.
model Upload {
  id           String   @id @default(cuid())
  reportDate   DateTime
  createdAt    DateTime @default(now())
  leadFileName String?
  taskFileName String?
  leadCount    Int      @default(0)
  taskCount    Int      @default(0)

  leads Lead[]
  tasks Task[]

  @@index([reportDate])
}

/// A normalized CRM lead (from "CRM Daily Leads").
model Lead {
  id          String    @id @default(cuid())
  uploadId    String
  upload      Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  externalId  String?
  contact     String?
  phone       String?
  email       String?
  pipeline    String?
  rawStage    String?
  rawSource   String?
  rawProject  String?

  staff       String    // Nikhita | Anusha | Jyothi | Nalini | Unassigned
  source      String    // Google | Meta | Organic | 99 Acres | Housing | Hoarding | CP | Other
  project     String    // Anuhar Towers | RR Towers | Gauthami Heights | Pocharam | Other
  stage       String    // New | Interested | SV Scheduled | SV Done | Closure | Lost
  temperature String    // Hot | Warm | Cold | Lost
  isFirst     Boolean   @default(true)
  createdDate DateTime?
  reportDate  DateTime

  @@index([reportDate])
  @@index([staff])
  @@index([source])
  @@index([project])
  @@index([stage])
}

/// A normalized followup task (from "Followup").
model Task {
  id          String    @id @default(cuid())
  uploadId    String
  upload      Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  externalId  String?
  title       String?
  description String?
  contact     String?
  phone       String?
  staff       String    // Nikhita | Anusha | Jyothi | Nalini | Unassigned
  status      String    // Completed | Pending | Overdue
  createdDate DateTime?
  dueDate     DateTime?
  reportDate  DateTime

  @@index([reportDate])
  @@index([staff])
  @@index([status])
}
